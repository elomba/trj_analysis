!===============================================================================
! Input Configuration: 3D MEAM Dynamics (Modified Embedded Atom Method Alloy)
!===============================================================================

&INPUT
  log_output_file='trj_analysis.log'  ! Log output filename
  trj_input_file='run.nc'            ! Input NetCDF trajectory file
  ndim=3                             ! Spatial dimensions (3D)
  nsp=2                              ! Number of chemical species to analyze
  nqw=1                              ! Number of Q-values for dynamic S(Q,w)
  norder=5                           ! Number of Steinhardt order parameters in orderp
  ncfs_from_to=1000 1 1000           ! Trajectory frames: [start, stride, end]
  rcl=2.59                           ! Cutoff distance for nearest neighbors & clustering
  rdf_sq_cl_dyn_sqw_conf_ord=T T F T F F F ! Module flags: [RDF, S(Q), Cluster, Dyn, S(Q,w), Conf, Order]
  ener_name="ener"                   ! LAMMPS compute name for potential energy
  press_name="stress"                ! LAMMPS compute name for stress tensor
  periodic=.t. .t. .t.               ! Periodic boundary conditions for each dimension (x, y, z)
  nprint=10                          ! Progress reporting frequency (every N frames)
/

&INPUT_SP
  sp_types_selected=2 1              ! Selected LAMMPS atom type IDs for species
  mat=12.0 28.0                      ! Atomic masses for each selected species
/

&INPUT_RDF
  deltar=0.25                        ! Radial grid bin spacing for RDF g(r)
  rcrdf=25.0                         ! Cutoff distance for RDF calculation
/

&INPUT_SQ
  qmax=5.5                           ! Maximum wavevector magnitude Q for S(Q)
  qmin=5.5                           ! Minimum wavevector magnitude Q for S(Q)
/

&INPUT_CL
  dcl=6.0                            ! Grid spacing for cluster size distribution
  ndrclus=200                        ! Bins for cluster radial density profiles
/

&INPUT_DYN
  nbuffer=40                         ! Number of time origins for dynamics calculations
  tmax=0.222                         ! Maximum time window for correlations
  jump=20                            ! Frame stride between time origins in correlation functions
/

&INPUT_SQW
  qw=0.18                            ! Q-vector magnitude for intermediate scattering function F(Q,t)
/

&INPUT_ORDER
  orderp=4 6 8 10 12                 ! Steinhardt order parameter l-indices (Q_l)
  print_orderp=.true.                ! Output per-particle order parameters to file
  rclcl=110.0                        ! Cutoff distance for inter-cluster neighbor analysis
/

