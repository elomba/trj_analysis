&INPUT
  log_output_file='trj_analysis.log'
  trj_input_file='run.nc'
  ndim=3
  nsp=1
  nqw=1
  norder=5
  nthread=64
  ncfs_from_to=1 1 1
  rcl=18.0
  rdf_sq_cl_dyn_sqw_conf_ord=T T F F F  F T
  ener_name="ener"
  press_name="stress"
  periodic=.t. .t. .t.
/
&INPUT_SP
  sp_types_selected=1 
  mat=1.0 
/
&INPUT_RDF
  deltar=0.5
  rcrdf=500.0 ! Cutoff in rdf
/
&INPUT_SQ
  qmax=8.0
  qmin=0.2
/
&INPUT_CL
  dcl=6.0
  jmin=5
  minclsize=5 ! Minimum size to plot cluster trajectory & density
  ndrclus=200
/
&INPUT_DYN
nbuffer=6 ! No.of time origins to compute dynamics
tmax=2.0
/
&INPUT_SQW
qw=0.18
/
&INPUT_ORDER
orderp=4 6 8 10 12
nnbond=0
print_orderp=.true.
rclcl=275.0
/
&INPUT_CONF
  idir=0
  pwall=0.0
  pwallp=0.0
/
