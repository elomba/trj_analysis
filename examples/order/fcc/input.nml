!===============================================================================
! Input Configuration: Order Parameters (Face-Centered Cubic Lattice)
!===============================================================================

&INPUT
  log_output_file='trj_analysis.log'  ! Log output filename
  trj_input_file='run.nc'            ! Input NetCDF trajectory file
  ndim=3                             ! Spatial dimensions (3D)
  nsp=1                              ! Number of chemical species to analyze
  nqw=1                              ! Number of Q-values for dynamic S(Q,w)
  norder=5                           ! Number of Steinhardt order parameters in orderp
  nthread=64                         ! CUDA threads per block for GPU kernels
  ncfs_from_to=1 1 1                 ! Trajectory frames: [start, stride, end]
  rcl=15.5                           ! Cutoff distance for nearest neighbors & bond definitions
  rdf_sq_cl_dyn_sqw_conf_ord=T T F F F F T ! Module flags: [RDF, S(Q), Cluster, Dyn, S(Q,w), Conf, Order]
  ener_name="ener"                   ! LAMMPS compute name for potential energy
  press_name="stress"                ! LAMMPS compute name for stress tensor
  periodic=.t. .t. .t.               ! Periodic boundary conditions for each dimension (x, y, z)
/

&INPUT_SP
  sp_types_selected=1                ! Selected LAMMPS atom type IDs for species
  mat=1.0                            ! Atomic mass for each species
/

&INPUT_RDF
  deltar=0.5                         ! Radial grid bin spacing for RDF g(r)
  rcrdf=500.0                        ! Cutoff distance for RDF calculation
/

&INPUT_SQ
  qmax=8.0                           ! Maximum wavevector magnitude Q for S(Q)
  qmin=0.2                           ! Minimum wavevector magnitude Q for S(Q)
/

&INPUT_CL
  dcl=6.0                            ! Grid spacing for cluster size distribution
  jmin=5                             ! Minimum cluster size threshold
  minclsize=5                        ! Minimum cluster size to plot cluster trajectory & density
  ndrclus=200                        ! Bins for cluster radial density profiles
/

&INPUT_DYN
  nbuffer=6                          ! Number of time origins for dynamics calculations
  tmax=2.0                           ! Maximum time window for correlations
/

&INPUT_SQW
  qw=0.18                            ! Q-vector magnitude for intermediate scattering function F(Q,t)
/

&INPUT_ORDER
  orderp=4 6 8 10 12                 ! Steinhardt order parameter l-indices (Q_l)
  nnbond=12                          ! Fixed number of nearest neighbors (12 for FCC)
  print_orderp=.true.                ! Output per-particle order parameters to file
  rclcl=275.0                        ! Cutoff distance for inter-cluster neighbor analysis
/

&INPUT_CONF
  idir=0                             ! Confinement axis (0 = isotropic / no confinement)
  pwall=0.0                          ! Wall position lower limit
  pwallp=0.0                         ! Wall position upper limit
/

