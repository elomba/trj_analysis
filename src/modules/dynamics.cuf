!===============================================================================
! Module: mod_dyn
!===============================================================================
! Purpose:
!   Computes dynamic properties from molecular trajectories including time
!   correlation functions, intermediate scattering functions, and dynamic
!   structure factors. Uses multi-buffer algorithm for efficient temporal
!   averaging with shifted time origins.
!
! Key Functionality:
!   - Mean squared displacement (MSD) computation
!   - Velocity autocorrelation functions ⟨v(t)·v(0)⟩
!   - Stress tensor autocorrelation for shear viscosity
!   - Intermediate scattering functions: F(Q,t) and Fs(Q,t) (total and self)
!   - Dynamic structure factors: S(Q,ω) and Ss(Q,ω) via Fourier transform
!   - Multi-buffer temporal averaging with configurable time origins
!   - Frequency-domain analysis Z(ω) for transport properties
!
! Algorithm Details:
!   - Simultaneous correlation calculation over nbuffer independent time origins
!   - Time origins separated by 'jump' configurations
!   - Averages computed over time window 'tlimit' (ps)
!   - Origins automatically shifted when tlimit exceeded
!   - Window functions applied at tmax for FFT operations
!   - Separate windowing at tmaxp for viscosity calculations
!
! Main Variables:
!   nbuffer    - Number of independent time origins for averaging
!   jump       - Configuration stride between time origins
!   tlimit     - Time window for averaging before origin shift (ps)
!   tmax       - Maximum correlation time with windowing for FFT
!   tmaxp      - Maximum time for viscosity windowing
!   ndyn       - Effective number of configurations for analysis
!   itlimit    - Configuration index limit for time window
!
! Arrays:
!   r0, v0, p0          - Initial positions, velocities, stress at time origins
!   r2t, v2t            - Mean squared displacement and velocity correlation
!   fkt, fskt           - Intermediate scattering functions F(Q,t), Fs(Q,t)
!   sqw, ssqw           - Dynamic structure factors S(Q,ω), Ss(Q,ω)
!   stcorr              - Stress tensor autocorrelation
!   origin              - Configuration indices for time origins
!
! GPU Arrays (device):
!   r0_d, rt_d, v0_d    - Positions and velocities on GPU
!   fktb_d, fsktb_d     - Buffer for scattering function accumulation
!   stcorr_d, poff_d    - Stress correlation buffers
!   qw_d, indqw_d       - Q-vectors and indices for S(Q,ω)
!
! Subroutines:
!   dyn_init()          - Initialize arrays and parameters
!   dyn_kernel()        - Main GPU kernel for correlation computation
!   dyn_finalize()      - FFT to frequency domain and output
!   dyn_clear()         - Deallocate arrays
!
! Notes:
!   - Requires velocities in trajectory for velocity correlations
!   - Stress tensor needed for viscosity calculation
!   - Buffer count limited to nbmax (1000) for memory management
!   - Operations split into nblocks (5) for large particle counts
!   - Q-vectors for S(Q,ω) specified via INPUT_SQW namelist
!===============================================================================
module mod_dyn
   use mod_precision
   use mod_common
   use cudafor
   use mod_input
   implicit none
   integer :: ndyn, count_org=0, itlimit, n_freq
   integer, allocatable, dimension(:) :: origin
   integer, device, allocatable, dimension(:) :: origin_d
   integer, parameter :: nbmax = 1000, nblocks = 5 ! Max. number of buffers, number of blocks to split
   ! operations with particles
   real(myprec), device, allocatable, dimension(:,:,:) :: r0_d, rt_d, v0_d, fktb_d, fsktb_d, jlktb_d, jlsktb_d
   real(myprec), device, allocatable, dimension(:,:) :: r2tb_d, v2tb_d, poff_d, stcorr_d, p0_d
   real(myprec), device, allocatable, dimension(:) :: qw_d
   integer (kind=2), device, allocatable, dimension(:,:) :: indqw_d
   real(myprec), allocatable, dimension(:,:,:) :: r0, v0
   real(double),  allocatable, dimension(:,:) :: fkt, fskt, sqw, ssqw, jlkt, jlskt, clqw, cslqw
   real(double),  allocatable, dimension(:) :: t, v2t
   real(double),  allocatable, dimension(:) :: r2t, stcorr
   real(double), allocatable, dimension(:,:) :: stcorrb, p0
   real(double), allocatable, dimension(:) :: pxy, pxz, pyz
   real(double), allocatable, dimension(:) :: w, ftv
   real(double) :: sumvel=0
contains

   subroutine dyn_init()
      !
      ! Initialize dynamic correlation vars and utils
      !
      integer :: nu
      if (nbuffer > nbmax) then
         write(*,'("** Error: nbuffer > ",i3,", redimension if possible !")') nbmax
         stop
      endif
      ndyn = Nconf-(nbuffer-1)*jump
      nu = ceiling(log(real(ndyn))/log(2.00))
      n_freq = 2**nu + 1
      Write(*,"(' *** Using ',i7,' configurations for dynamic analysis: ',&
         i4,' buffers starting every ',i3,' configuration ' )")ndyn, nbuffer, jump
      if (ndyn < 10) then
         write(*,"('** Error: length of dynamics to short. Reduce number of buffers !')")
         stop
      endif
      allocate(t(ndyn),r2t(ndyn))
      allocate(r0(ndim,Nsites,nbuffer))
      allocate(origin(nbuffer))
      allocate(origin_d(nbuffer))
      allocate(r0_d(ndim,Nsites,nbuffer),rt_d(ndim,Nsites,nbuffer),r2tb_d(ndyn,nbuffer))
      r2tb_d(:,:) = 0
      r2t(:) = 0
      if (ex_vel) then
         allocate(v0(ndim,Nsites,nbuffer),v2t(ndyn))
         allocate(v0_d(ndim,Nsites,nbuffer),v2tb_d(ndyn,nbuffer))
         v2tb_d(:,:) = 0
         v2t(:) = 0
         allocate(w(n_freq),ftv(n_freq))
      endif
      if (ex_stress) then
         allocate(poff_d(1:3,1:Nsites),stcorr_d(ndyn,nbuffer),&
            p0_d(1:3,1:nbuffer))
         p0_d(:,:) = 0.0
         allocate(stcorr(ndyn),stcorrb(ndyn,nbuffer),&
            p0(1:3,1:nbuffer))
         allocate(pxy(Nsites),pxz(Nsites),pyz(Nsites))
         stcorr(:) = 0.0_double
         stcorrb(:,:) = 0.0_double
         p0(:,:) = 0.0_double
         stcorr_d(:,:) = 0.0
         poff_d(:,:) = 0.0
      endif
      if (run_sqw) then
         allocate(fkt(nqw,ndyn),fskt(nqw,ndyn))
         allocate(sqw(n_freq,nqw),ssqw(n_freq,nqw))
         allocate(fktb_d(nqw,ndyn,nbuffer),fsktb_d(nqw,ndyn,nbuffer),qw_d(nqw))
         qw_d(:) = qw(:)
         fktb_d(:,:,:) = 0.0
         fsktb_d(:,:,:) = 0.0
         fkt(:,:) = 0.0
         fskt(:,:) = 0.0
         if (ex_vel) then
            allocate(jlkt(nqw,ndyn), jlskt(nqw,ndyn))
            allocate(clqw(n_freq,nqw), cslqw(n_freq,nqw))
            allocate(jlktb_d(nqw,ndyn,nbuffer), jlsktb_d(nqw,ndyn,nbuffer))
            jlktb_d(:,:,:) = 0.0
            jlsktb_d(:,:,:) = 0.0
            jlkt(:,:) = 0.0
            jlskt(:,:) = 0.0
            clqw(:,:) = 0.0
            cslqw(:,:) = 0.0
         endif
      endif
   end  subroutine dyn_init

   subroutine dyn_clear()
      ! Deallocate memory
      deallocate(t,r2t)
      deallocate(r0)
      deallocate(r0_d,rt_d,r2tb_d)
      if (ex_vel) then
         deallocate(v0,v2t)
         deallocate(v0_d,v2tb_d)
         deallocate(w,ftv)
      endif
      if (ex_stress) then
         deallocate(stcorr,stcorrb,p0)
         deallocate(pxy,pxz,pyz)
         deallocate(stcorr_d,poff_d,p0_d)
      end if
      if (run_sqw) then
         deallocate(fkt,fskt,sqw,ssqw)
         deallocate(fktb_d,fsktb_d)
         if (allocated(jlkt)) deallocate(jlkt, jlskt, clqw, cslqw)
         if (allocated(jlktb_d)) deallocate(jlktb_d, jlsktb_d)
         if (allocated(indqw_d)) deallocate(indqw_d)
         if (allocated(qw_d)) deallocate(qw_d)
      endif
   end subroutine dyn_clear

   subroutine rtcorr(iconf)
      !
      ! Calculate averages of time correlation functions
      !
      integer, intent(in) :: iconf
      integer :: istat, iorg, i
      real :: time_gpu, v0(3), v(3)
      ! store times (in ps)
      if (iconf <= ndyn) t(iconf) = nstep*tstep
      ! define buffer origins
      if (iconf==1) then
         do i=1,nbuffer
            origin(i) = (i-1)*jump + 1
         enddo
         itlimit = Nconf
      elseif (iconf==2) then
         if (tlimit<0) then
            itlimit = Nconf-(nbuffer-1)*jump
            tlimit = itlimit*(t(2)-t(1))
         else
            itlimit = nint(tlimit/(t(2)-t(1)))
         endif
         if (itlimit > Nconf) then
            write(*, "(//' !!! *** Unrecoverable error: tmax=',f8.3,'> trajectory lenght !!')")tmax
            stop
         endif
         if (tmax<0) tmax=tlimit
         if (tmaxp<0) tmaxp=tmax
      endif
      origin_d(:) = origin(:)
      if (ex_vel) then
         v_d(1:ndim, 1:Nsites) = vel(1:ndim,1:Nsites)
      end if
      if (Nsites/nblocks<1) then
         write(*,"(' !!** Error: number of particles too small < ',i4)")nblocks
      endif
      istat = cudaEventRecord(startEvent, 0)
      ! Transfer origin positions and velocities for each buffer
      do i = 1, nbuffer
         if (iconf==origin(i)) then
            r0_d(1:ndim,1:Nsites,i) = r_d(1:ndim,1:Nsites)
            if (ex_vel) v0_d(1:ndim,1:Nsites,i) = v_d(1:ndim,1:Nsites)
         endif
      enddo

      call rtcal<<<nblocks,nbuffer>>>(ndim,Nsites,nbuffer,ndyn,iconf,&
         origin_d)

      if (ex_vel) call vtcal<<<nblocks,nbuffer>>>(ndim,Nsites,nbuffer,ndyn,iconf,&
         origin_d)

      if (ex_stress) then
         ! CPU code for viscosity
         pxy(1:Nsites) = -stress(4,1:Nsites)
         pxz(1:Nsites) = -stress(5,1:Nsites)
         pyz(1:Nsites) = -stress(6,1:Nsites)
         do i = 1, nbuffer
            call stcal(Nsites,nbuffer,ndyn,iconf,origin,i)
         enddo
         ! CPU code ends here
         !
         ! uncomment for GPU code for viscosity
         !poff_d(1:3,1:Nsites) = -stress(4:6,1:Nsites)/volumen
         !do i = 1, nbuffer
         !   if (origin(i)==iconf) then
         !      p0_d(1:3,i) = -sum(stress(4:6,1:Nsites),dim=2)/volumen
         !   endif
         !enddo
         !call st_cal<<<nblocks,nbuffer>>>(Nsites,nbuffer,ndyn,iconf,&
         !             origin_d)
      endif

      if (run_sqw) then
         if (iconf == 1) then
            allocate(indqw_d(nqwmax,ndim))
            indqw_d(:,:) = indqw(:,:)
         endif
         call  FqtnD<<<nqwmax,nbuffer>>>(nqwmax, nqw, Nsites, ndim, itype_d,&
            ntype_d, bsc_d, fk_d, nsp, dq, ndyn, iconf, nbuffer, origin_d, ex_vel)
      endif
      do i = 1, nbuffer
         iorg =  origin(i)
         !  Shift origin position if time limit reached for buffer i
         !  only if itlimit configurations remaining
         if(iconf-iorg==itlimit) iorg=iconf+1
         !
         ! Partial averages are not included in final results, only when itlimit
         ! confs have been read
         !
         if(origin(i) .ne. iorg) then
            ! add up buffers when itlimit reached
            origin(i) = iorg
            r2t(1:ndyn) = r2t(1:ndyn) + r2tb_d(1:ndyn,i)
            r2tb_d(1:ndyn,i) = 0
            if (ex_stress) then
               ! accumulate stress tensor
!               Uncomment for GPU
               !stcorr(1:ndyn) = stcorr(1:ndyn) + stcorr_d(1:ndyn,i)
               !stcorr_d(1:ndyn,i) = 0.0
               ! CPU code
               stcorr(1:ndyn) = stcorr(1:ndyn) + stcorrb(1:ndyn,i)
               stcorrb(1:ndyn,i) = 0.0
            endif
            if (ex_vel) then
               v2t(1:ndyn) = v2t(1:ndyn) +v2tb_d(1:ndyn,i)
               v2tb_d(1:ndyn,i) = 0.0
            endif
            if (run_sqw) then
               fkt(1:nqw,1:ndyn) = fkt(1:nqw,1:ndyn)+fktb_d(1:nqw,1:ndyn,i)
               fskt(1:nqw,1:ndyn) = fskt(1:nqw,1:ndyn)+fsktb_d(1:nqw,1:ndyn,i)
               fktb_d(1:nqw,1:ndyn,i) = 0
               fsktb_d(1:nqw,1:ndyn,i) = 0
               if (ex_vel) then
                  jlkt(1:nqw,1:ndyn) = jlkt(1:nqw,1:ndyn)+jlktb_d(1:nqw,1:ndyn,i)
                  jlskt(1:nqw,1:ndyn) = jlskt(1:nqw,1:ndyn)+jlsktb_d(1:nqw,1:ndyn,i)
                  jlktb_d(1:nqw,1:ndyn,i) = 0
                  jlsktb_d(1:nqw,1:ndyn,i) = 0
               endif
            endif
            count_org = count_org+1
         endif
      enddo
      time_gpu = gptime(stopEvent, startEvent)
      tdyn = tdyn + time_gpu
      call printcudaerror(" **! rtcorr GPU kernel exit")
   end subroutine rtcorr

   subroutine print_rtcor()
      !
      ! Print out time correlations
      !
      use fftw3
      implicit none
      integer :: i, j, n_tail, i_start
      real(double) :: fconv=4.135_double
      real(double) :: sum_visc=0.0_double, pct, pct1, alpha=10.0_double, fw, fq, fsq
      real(double), allocatable :: fkt_in(:), fskt_in(:)
      character(len=17), allocatable :: h1_list(:), h2_list(:), hj1_list(:), hj2_list(:)
      character(len=16), allocatable :: hf_list(:), hfs_list(:), hjl1_list(:), hjl2_list(:)
      t(1:ndyn) = t(1:ndyn)-t(1)
      write(*,"(/'** Length of dynamics ',f8.3,' ps, ',i7,' configurations, '&
         ,i5,' time origins'/)")t(ndyn),ndyn, count_org
      r2t(:) = r2t(:)/count_org
      if (ex_vel) then
         v2t(:) = v2t(:)/count_org
         call fftw1d(v2t,ftv,w,ndyn,n_freq,t(2)-t(1),real(tmax, kind=double))
      end if
      if (run_sqw) then
         !
         ! set q-dependent time window for F(q,t) transforms to tmx
         if (maxval(tmqw(:))<1.0e-6) then
            tmqw(:) = tmax
         endif
      endif
      open(55,file="dyn.dat")
      if(ex_vel) open(555,file="dynw.dat")
      if (run_sqw) then
         open(65,file='fqt.dat')
         open(66,file='fskt.dat')
         open(67,file='sqw.dat')
         if (ex_vel) then
            open(68,file='jqt.dat')
            open(69,file='clqw.dat')
         endif
         if (subtract_plateau .or. norm_sqw) allocate(fkt_in(itlimit), fskt_in(itlimit))
         do i=1, nqw
            fkt(i,1:ndyn)=fkt(i,1:ndyn)/(Nsites*count_org*nw(i))
            fskt(i,1:ndyn)=fskt(i,1:ndyn)/(Nsites*count_org*nw(i))
            if (ex_vel) then
               jlkt(i,1:ndyn)=jlkt(i,1:ndyn)/(Nsites*count_org*nw(i))
               jlskt(i,1:ndyn)=jlskt(i,1:ndyn)/(Nsites*count_org*nw(i))
               call fftw1d(jlkt(i,1:itlimit),  clqw(1:n_freq,i),  w, itlimit, n_freq, t(2)-t(1), real(tmax, kind=double))
               call fftw1d(jlskt(i,1:itlimit), cslqw(1:n_freq,i), w, itlimit, n_freq, t(2)-t(1), real(tmax, kind=double))
            endif
            if (subtract_plateau) then
               i_start = max(1, itlimit - 4)
               n_tail = itlimit - i_start + 1
               fq  = sum(fkt(i, i_start:itlimit)) / real(n_tail, kind=double)
               fsq = sum(fskt(i, i_start:itlimit)) / real(n_tail, kind=double)
               write(*,"(' *** Subtracted non-ergodicity plateau f_Q = ',f8.5,' (self f_sQ = ',f8.5,') for Q = ',f8.3,' [S(Q)=',f8.5,', F_inel(0)=',f8.5,']')") &
                     fq, fsq, qw(i), fkt(i,1), fkt(i,1)-fq
               fkt_in(1:itlimit)  = fkt(i, 1:itlimit)  - fq
               fskt_in(1:itlimit) = fskt(i, 1:itlimit) - fsq
               if (norm_sqw) then
                  if (abs(fkt(i,1)) > 1.0e-12_double) fkt_in(1:itlimit) = fkt_in(1:itlimit) / fkt(i,1)
                  if (abs(fskt(i,1)) > 1.0e-12_double) fskt_in(1:itlimit) = fskt_in(1:itlimit) / fskt(i,1)
               endif
               call fftw1d(fkt_in(1:itlimit),  sqw(1:n_freq,i),  w, itlimit, n_freq, t(2)-t(1), real(tmax, kind=double))
               call fftw1d(fskt_in(1:itlimit), ssqw(1:n_freq,i), w, itlimit, n_freq, t(2)-t(1), real(tmax, kind=double))
            else
               if (norm_sqw) then
                  if (abs(fkt(i,1)) > 1.0e-12_double) then
                     fkt_in(1:itlimit) = fkt(i, 1:itlimit) / fkt(i,1)
                  else
                     fkt_in(1:itlimit) = fkt(i, 1:itlimit)
                  endif
                  if (abs(fskt(i,1)) > 1.0e-12_double) then
                     fskt_in(1:itlimit) = fskt(i, 1:itlimit) / fskt(i,1)
                  else
                     fskt_in(1:itlimit) = fskt(i, 1:itlimit)
                  endif
                  call fftw1d(fkt_in(1:itlimit),  sqw(1:n_freq,i),  w, itlimit, n_freq, t(2)-t(1), real(tmax, kind=double))
                  call fftw1d(fskt_in(1:itlimit), ssqw(1:n_freq,i), w, itlimit, n_freq, t(2)-t(1), real(tmax, kind=double))
               else
                  call fftw1d(fkt(i,1:itlimit),  sqw(1:n_freq,i),  w, itlimit, n_freq, t(2)-t(1), real(tmax, kind=double))
                  call fftw1d(fskt(i,1:itlimit), ssqw(1:n_freq,i), w, itlimit, n_freq, t(2)-t(1), real(tmax, kind=double))
               endif
            endif
         enddo
         if (allocated(fkt_in)) deallocate(fkt_in, fskt_in)
      endif
      if (ex_stress) then
         open(56,file="viscor.dat")
         if (tunits == 'lj') then
            write(56,"('#',2x,'t(tau)',9x,'P_off(t)',7x,'eta_GK(t) (eps*tau/sig^3)')")
         else
            write(56,"('#',2x,'t(ps)',9x,'P_off(t)',7x,'eta_GK(t) (bar*ps))')")
         endif
      endif
      if (ex_vel) then
         if (tunits == 'lj') then
            write(55,"('#',2x,'t(tau)',9x,'C_r(t)',7x'C_v(t)')')")
            write(555,"('#',9x,'w(tau^-1)        Z(w)')")
         else
            write(55,"('#',2x,'t(ps)',9x,'C_r(t)',7x'C_v(t)')')")
            write(555,"('#',9x,'w(THz)',7x,'w(meV)',12x,'Z(w)')")
         endif
      else
         if (tunits == 'lj') then
            write(55,"('#',2x,'t(tau)',9x,'C_r(t)')")
         else  
            write(55,"('#',2x,'t(ps)',9x,'C_r(t)')")
         endif
      endif
      if (run_sqw) then
         allocate(h1_list(nqw), h2_list(nqw), hf_list(nqw), hfs_list(nqw))
         do j = 1, nqw
            write(hf_list(j),  "('    F(',f6.3,',t)')") qw(j)
            write(hfs_list(j), "('   Fs(',f6.3,',t) ')") qw(j)
            if (subtract_plateau .and. norm_sqw) then
               write(h1_list(j), "('Sinel(',f6.3,')/SQ')") qw(j)
               write(h2_list(j), "('Ssinel(',f6.3,',w)')") qw(j)
            else if (subtract_plateau) then
               write(h1_list(j), "(' Sinel(',f6.3,',w)')") qw(j)
               write(h2_list(j), "('Ssinel(',f6.3,',w)')") qw(j)
            else if (norm_sqw) then
               write(h1_list(j), "('   S(',f6.3,',w)/SQ')") qw(j)
               write(h2_list(j), "('  Ss(',f6.3,',w)  ')") qw(j)
            else
               write(h1_list(j), "('   S(',f6.3,',w)   ')") qw(j)
               write(h2_list(j), "('  Ss(',f6.3,',w)   ')") qw(j)
            endif
         enddo
         if (tunits == 'lj') then
            write(65,"('#  t(tau)   ',*(a16))") (hf_list(j), j=1,nqw)
            write(66,"('#  t(tau)   ',*(a16))") (hfs_list(j), j=1,nqw)
            write(67,"('#  w(1/tau) ',*(a17,a17))") (h1_list(j), h2_list(j), j=1,nqw)
         else
            write(65,"('#   t(ps)   ',*(a16))") (hf_list(j), j=1,nqw)
            write(66,"('#   t(ps)   ',*(a16))") (hfs_list(j), j=1,nqw)
            write(67,"('#   w(THz)     w(meV)  ',*(a17,a17))") (h1_list(j), h2_list(j), j=1,nqw)
         endif
         if (allocated(h1_list)) deallocate(h1_list, h2_list, hf_list, hfs_list)
         if (ex_vel) then
            allocate(hj1_list(nqw), hj2_list(nqw), hjl1_list(nqw), hjl2_list(nqw))
            do j = 1, nqw
               write(hjl1_list(j), "('   Jl(',f6.3,',t) ')") qw(j)
               write(hjl2_list(j), "('  Jls(',f6.3,',t) ')") qw(j)
               write(hj1_list(j),  "('  Cl(',f6.3,',w)   ')") qw(j)
               write(hj2_list(j),  "(' Csl(',f6.3,',w)   ')") qw(j)
            enddo
            if (tunits == 'lj') then
               write(68,"('#  t(tau)   ',*(a16,a16))") (hjl1_list(j), hjl2_list(j), j=1,nqw)
               write(69,"('#  w(1/tau) ',*(a17,a17))") (hj1_list(j), hj2_list(j), j=1,nqw)
            else
               write(68,"('#   t(ps)   ',*(a16,a16))") (hjl1_list(j), hjl2_list(j), j=1,nqw)
               write(69,"('#   w(THz)     w(meV)  ',*(a17,a17))") (hj1_list(j), hj2_list(j), j=1,nqw)
            endif
            if (allocated(hj1_list)) deallocate(hj1_list, hj2_list, hjl1_list, hjl2_list)
         endif
      endif

      ! Time-domain outputs (1 to itlimit)
      do i = 1, itlimit
         if (ex_vel) then
            write(55,"(f10.3,*(1x,f15.5))")t(i), r2t(i),v2t(i)
         else
            write(55,"(f10.3,*(1x,f15.5))")t(i), r2t(i)
         endif
         if (ex_stress) then
            fw = 0.5*(1-tanh((alpha/tmaxP)*(t(i)-tmaxP)))
            if (i==1) then
               pct =  fw*stcorr(i)/(ndim*count_org)
               write(56,"(f10.3,8f17.5)")t(i),pct,0.0
            else
               pct1 = pct
               pct =  fw*stcorr(i)/(ndim*count_org)
               ! Integrate off-diagonal pressure tensor correlation (trapezoidal rule)
               ! Use Green-Kubo relation eta_gk = (V/kT)*\int_0^t<pxy(t')pxy(0)>dt'
               sum_visc = sum_visc + (pct+pct1)*(t(i)-t(i-1))/2
               if (tunits == 'lj') then
                  write(56,"(f10.3,9f17.5)")t(i),pct,(volumen/temperature)*sum_visc
               else
                  write(56,"(f10.3,9f17.5)")t(i),pct,(volumen/temperature/c_nktv)*sum_visc
               endif
            endif
         end if
         if (run_sqw) then
            write(65,"(f10.3,*(1x,f15.5))")t(i),fkt(1:nqw,i)
            write(66,"(f10.3,*(1x,f15.5))")t(i),fskt(1:nqw,i)
            if (ex_vel) write(68,"(f10.3,*(1x,f15.5))")t(i),(jlkt(j,i),jlskt(j,i),j=1,nqw)
         endif
      end do

      ! Frequency-domain outputs (1 to n_freq, full spectrum up to Nyquist)
      if (ex_vel) then
         do i = 1, n_freq
            if (tunits=='lj') then
               write(555,"(8f15.5)")w(i)/(2*pi),ftv(i)
            else 
               write(555,"(8f15.5)")w(i)/(2*pi),fconv*w(i)/(2*pi),ftv(i)
            endif
         end do
      endif
      if (run_sqw) then
         do i = 1, n_freq
            if (tunits == 'lj') then
               write(67,"(f11.4,*(1x,f16.6))")w(i)/(2*pi),(sqw(i,j),ssqw(i,j),j=1,nqw)
               if (ex_vel) write(69,"(f11.4,*(1x,f16.6))")w(i)/(2*pi),(clqw(i,j),cslqw(i,j),j=1,nqw)
            else
               write(67,"(2f11.4,*(1x,f16.6))")w(i)/(2*pi),fconv*w(i)/(2*pi),(sqw(i,j),ssqw(i,j),j=1,nqw)
               if (ex_vel) write(69,"(2f11.4,*(1x,f16.6))")w(i)/(2*pi),fconv*w(i)/(2*pi),(clqw(i,j),cslqw(i,j),j=1,nqw)
            endif
         end do
      endif
      close(55)
      if(ex_vel) close(555)
      if(ex_stress) close(56)
      if(run_sqw) then
         close(65)
         close(66)
         close(67)
         if (ex_vel) then
            close(68)
            close(69)
         endif
      endif
   end subroutine print_rtcor

   subroutine stcal(mol,buffer,dyn,iconf,origin, i)
      !
      ! off-diagonal pressure tensor time correlation. CPU version
      !
      integer, value, intent(IN) :: mol, buffer, dyn, iconf, i
      real(double) :: sumaxy, sumayz, sumaxz, sumaxx, sumayy, sumazz, suma
      integer :: j, k, npsize, nprest, ia, indx, iorg
      integer, dimension(buffer), intent(in) :: origin
      iorg = origin(i)
      indx = iconf - iorg + 1
! Check origin and final configuration of each averaging buffer
      if (iconf>=iorg .and. indx <= dyn) then
         sumaxy = sum(pxy(1:mol))/volumen
         sumaxz = sum(pxz(1:mol))/volumen
         sumayz = sum(pyz(1:mol))/volumen
         if (iorg==iconf) then
            p0(1,i) = sumaxy
            p0(2,i) = sumaxz
            p0(3,i) = sumayz
         end if
         suma = sumaxy*p0(1,i)+sumaxz*p0(2,i)+sumayz*p0(3,i)
         stcorrb(indx,i) = stcorrb(indx,i)+suma
      endif
   end subroutine stcal


   attributes(global) subroutine FqtnD(nqwmax, nqw, Nsites, dim, itype, ntype, &
      bsc, fk, nsp, dq, dyn, iconf, buffer, origin, ex_vel)
   !
   ! F(Q,t) and JL(Q,t): GPU version parallelization over Q vectors
   !
   integer, intent(IN) :: itype(Nsites), ntype(nsp)
   integer, value, intent(IN) :: Nsites, dim, nsp, nqwmax, dyn, iconf,&
      nqw, buffer
   logical, value, intent(IN) :: ex_vel
   integer :: ibuffer, indx
   real(myprec), intent(IN) :: bsc(nsp)
   real(myprec) :: rkxyz, rkxyzt, fk1, fk2, fk3, kf1, kf2, kf3, tsum, q, suma
   real(myprec) :: invq, hat_qx, hat_qy, hat_qz, vL0, vLt, tsum_j
   real(myprec) :: c0, s0, ct, st
   real(double) :: sumcx, sumsx, sumcpx, sumspx, q2, bs
   real(double) :: sumcxt, sumsxt, sumcpxt, sumspxt, sumself
   real(double) :: sumjcx, sumjsx, sumjcpx, sumjspx
   real(double) :: sumjcxt, sumjsxt, sumjcpxt, sumjspxt, sumjself
   real(myprec), intent(IN) :: fk(dim)
   real(myprec), value, intent(IN) ::  dq
   integer, dimension(buffer), intent(in) :: origin

   integer :: i, j, it, kx, ky, kz, ind, ia, iorg
   logical :: found
   if (blockidx%x<=nqwmax) then
      ibuffer = threadidx%x
      iorg =  origin(ibuffer)
      indx = iconf - iorg + 1
      ! Check origin and final configuration of each averaging buffer
      if (iconf>=iorg .and. indx >= 1) then
         kx = indqw_d(blockidx%x,1)
         ky = indqw_d(blockidx%x,2)
         fk1 = fk(1)
         fk2 = fk(2)
         kf1 = kx*fk1
         kf2 = ky*fk2
         if (dim==3) then
            kz = indqw_d(blockidx%x,3)
            fk3 = fk(3)
            kf3 = kz*fk3
            q2 = kf1*kf1 + kf2*kf2 + kf3*kf3
         else
            q2 = kf1*kf1 + kf2*kf2
         endif
         sumcx = 0
         sumcxt = 0
         sumsx = 0
         sumsxt = 0
         sumself = 0
         q = sqrt(q2)
         hat_qz = 0.0
         if (ex_vel) then
            invq = 1.0 / q
            hat_qx = kf1 * invq
            hat_qy = kf2 * invq
            if (dim==3) hat_qz = kf3 * invq
            sumjcx = 0
            sumjcxt = 0
            sumjsx = 0
            sumjsxt = 0
            sumjself = 0
         endif
         ind = 1
         found = .false.
         do while (ind<=nqw.and. .not. found)
            if (qw_d(ind)-dq/2<q .and. qw_d(ind)+dq/2>q) then
               found = .true.
            else
               ind = ind+1
            endif
         enddo
         i = 0
         do j = 1, nsp
            sumcpx = 0
            sumspx = 0
            sumcpxt = 0
            sumspxt = 0
            if (ex_vel) then
               sumjcpx = 0
               sumjspx = 0
               sumjcpxt = 0
               sumjspxt = 0
            endif
            bs = bsc(j)
            do it = 1, ntype(j)
               i = i + 1
               if (dim==3) then
                  rkxyz = r0_d(3, i,ibuffer)*kf3+r0_d(2, i,ibuffer)*kf2+r0_d(1, i,ibuffer)*kf1
                  rkxyzt = r_d(3, i)*kf3+r_d(2, i)*kf2+r_d(1, i)*kf1
               else
                  rkxyz = r0_d(2, i,ibuffer)*kf2+r0_d(1, i,ibuffer)*kf1
                  rkxyzt = r_d(2, i)*kf2+r_d(1, i)*kf1
               endif
               c0 = __cosf(rkxyz)
               s0 = __sinf(rkxyz)
               ct = __cosf(rkxyzt)
               st = __sinf(rkxyzt)
               sumcpx = sumcpx + c0
               sumspx = sumspx + s0
               sumcpxt = sumcpxt + ct
               sumspxt = sumspxt + st
               sumself = sumself + __cosf(rkxyzt-rkxyz)
               if (ex_vel) then
                  if (dim==3) then
                     vL0 = v0_d(1,i,ibuffer)*hat_qx + v0_d(2,i,ibuffer)*hat_qy + v0_d(3,i,ibuffer)*hat_qz
                     vLt = v_d(1,i)*hat_qx + v_d(2,i)*hat_qy + v_d(3,i)*hat_qz
                  else
                     vL0 = v0_d(1,i,ibuffer)*hat_qx + v0_d(2,i,ibuffer)*hat_qy
                     vLt = v_d(1,i)*hat_qx + v_d(2,i)*hat_qy
                  endif
                  sumjcpx = sumjcpx + vL0*c0
                  sumjspx = sumjspx + vL0*s0
                  sumjcpxt = sumjcpxt + vLt*ct
                  sumjspxt = sumjspxt + vLt*st
                  sumjself = sumjself + vLt*vL0*__cosf(rkxyzt-rkxyz)
               endif
            end do
            sumcx = sumcx + bs*sumcpx
            sumcxt = sumcxt + bs*sumcpxt
            sumsx = sumsx + bs*sumspx
            sumsxt = sumsxt + bs*sumspxt
            if (ex_vel) then
               sumjcx = sumjcx + bs*sumjcpx
               sumjcxt = sumjcxt + bs*sumjcpxt
               sumjsx = sumjsx + bs*sumjspx
               sumjsxt = sumjsxt + bs*sumjspxt
            endif
         end do
         tsum = (sumcx*sumcxt + sumsx*sumsxt)
         ia = atomicadd(fktb_d(ind,indx,ibuffer), tsum)
         ia = atomicadd(fsktb_d(ind,indx,ibuffer), real(sumself,kind=4))
         if (ex_vel) then
            tsum_j = (sumjcx*sumjcxt + sumjsx*sumjsxt)
            ia = atomicadd(jlktb_d(ind,indx,ibuffer), tsum_j)
            ia = atomicadd(jlsktb_d(ind,indx,ibuffer), real(sumjself,kind=4))
         endif
      endif
   endif
end subroutine FqtnD


attributes(global) subroutine rtcal(dim,mol,buffer,dyn,iconf,origin)
!
!   C(t,t0) = <r(t)r(t0)> time correlation. Parallelization over buffers (time origin)
!   (threads) and particles (blocks)
!
integer, value, intent(IN) :: mol, dim, buffer, dyn, iconf
real :: rv(3), suma
real(double) :: suma8
integer :: i, j, k, npsize, nprest, ia, indx, iorg, jmax
integer, dimension(buffer), intent(in) :: origin
i = threadidx%x
iorg = origin(i)
indx = iconf - iorg + 1
! Check origin and final configuration of each averaging buffer
if (iconf==iorg) rt_d(1:dim,1:mol,i) = r_d(1:dim,1:mol)

if (iconf>=iorg .and. indx <= dyn) then
   suma8 = 0
   npsize = mol/nblocks
   nprest = mod(mol,nblocks)
   ! Unwrap coordinates
   do k = 1, dim
      rt_d(k,1:mol,i)= r_d(k,1:mol) +sidel_d(k)&
      &  *nint((rt_d(k,1:mol,i)-r_d(k,1:mol))/sidel_d(k))
   end do
   suma8 = 0
   jmax = blockidx%x*npsize
   if (jmax + nprest == mol) jmax = mol
   do j = (blockidx%x - 1)*npsize+1, jmax
      rv(1:dim) = rt_d(1:dim,j,i)-r0_d(1:dim,j,i)
      suma8 = dot_product(rv,rv) + suma8
   end do
   suma = suma8/mol
   if (indx <= dyn .and. i <= buffer) then
      ia = atomicadd(r2tb_d(indx,i),suma)
   endif
endif
end subroutine rtcal

attributes(global) subroutine st_cal(mol,buffer,dyn,iconf,&
   origin)
integer, value, intent(IN) :: mol, buffer, dyn, iconf
real :: suma
real(double) :: sumaxy, sumayz, sumaxz, sumaxx, sumayy, sumazz
integer :: i, j, k, npsize, nprest, ia, indx, iorg, jmax
integer, dimension(buffer), intent(in) :: origin
i = threadidx%x
iorg = origin(i)
indx = iconf - iorg + 1
! Check origin and final configuration of each averaging buffer
if (iconf>=iorg .and. indx <= dyn) then
   npsize = mol/nblocks
   nprest = mod(mol,nblocks)
   sumaxy = 0.0d0
   sumaxz = 0.0d0
   sumayz = 0.0d0
   jmax = blockidx%x*npsize
   if (jmax + nprest == mol) jmax = mol
   do j = (blockidx%x - 1)*npsize+1, jmax
      sumaxy = sumaxy + poff_d(1,j)
      sumaxz = sumaxz + poff_d(2,j)
      sumayz = sumayz + poff_d(3,j)
   enddo
   suma = sumaxy*p0_d(1,i)+sumaxz*p0_d(2,i)+sumayz*p0_d(3,i)
   ia = atomicadd(stcorr_d(indx,i),suma)
endif
end subroutine st_cal

attributes(global) subroutine vtcal(dim,mol,buffer,dyn,iconf,origin)
integer, value, intent(IN) :: mol, dim, buffer, dyn, iconf
real(double) :: suma8
real :: sumf
integer :: i, j, k, npsize, nprest, ia, indx, iorg, jmax
integer, dimension(buffer), intent(in) :: origin
i = threadidx%x
iorg = origin(i)
indx = iconf - iorg + 1
! Check origin and final configuration of each averaging buffer
if (iconf>=iorg .and. indx >= 1) then
   npsize = mol/nblocks
   nprest = mod(mol,nblocks)
   suma8 = 0.0d0
   jmax = blockidx%x*npsize
   if (jmax + nprest == mol) jmax = mol
   do j = (blockidx%x - 1)*npsize+1, jmax
      suma8 = dot_product(v_d(1:dim,j),v0_d(1:dim,j,i)) + suma8
   end do
   sumf = suma8/mol
   ia = atomicadd(v2tb_d(indx,i),sumf)
endif
end subroutine vtcal

end module mod_dyn
